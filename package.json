{
  "name": "delta-paper",
  "version": "11.0.0",
  "description": "Progressive Web App (PWA) for paper trading on Delta Exchange India derivatives market. Now with strict TypeScript, Vite build tooling, and Vitest testing.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "paper-trading",
    "delta-exchange",
    "crypto",
    "pwa",
    "trading"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "decimal.js": "^10.6.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.19",
    "vitest": "^1.6.0"
  },
  "packageManager": "npm@10.8.2+sha512.c7f0088c520a46596b85c6f8f1da943400199748a0f7ea8cb8df75469668dc26f6fb3ba26df87e2884a5ebe91557292d0f3db7d0929cdb4f14910c3032ac81fb"
}
