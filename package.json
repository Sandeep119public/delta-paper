{
  "name": "delta-papers",
  "version": "1.0.0",
  "description": "Progressive Web App (PWA) for paper trading on Delta Exchange India derivatives market. Now with strict TypeScript, Vite build tooling, and Vitest testing.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["trading", "pwa", "delta-exchange", "paper-trading"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "decimal.js": "^10.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
