{
  "name": "delta-paper",
  "version": "10.0.0",
  "description": "Progressive Web App (PWA) for paper trading on Delta Exchange India derivatives market. Now with strict TypeScript, Vite build tooling, and Vitest testing.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "paper-trading",
    "delta-exchange",
    "crypto",
    "pwa",
    "trading"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "decimal.js": "^10.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@10.8.2+sha512.c7f0088c520a46596b85c6f8f1da943400199748a0f7ea8cb8df75469668dc26f6fb3ba26df87e2884a5ebe91557292d0f3db7d0929cdb4f14910c3032ac81fb"
}
